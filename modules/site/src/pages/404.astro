---
// /404.html: what an unknown address gets (Cloudflare Pages answers it with a 404 once this file exists). One page,
// in English as the root's (the decider, 2026-11-28): « 404 », « Not found », the way home; the site's own frame and
// ground; never indexed.
import Page from "../layouts/Page.astro";
import { say } from "../lib/words.mjs";
const [title, said, home] = say("lost", "en");
---
<Page lang="en" title={`${title} · Kitokey`} description={said} path="" kind="wrap lost-page" indexed={false}>
  <div class="lost"><p class="lost-code" aria-hidden="true">404</p><h1>{title}</h1><p>{said}</p><a class="home" href="/en/">{home}</a></div>
</Page>
