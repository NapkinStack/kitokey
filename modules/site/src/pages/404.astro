---
// /404.html: what an unknown address gets (Cloudflare Pages answers it with a 404 once this file exists, instead of
// the landing in 200). The site's own frame and ground, French first then English, each its sentence and its home.
import Page from "../layouts/Page.astro";
import { say } from "../lib/words.mjs";
const [frTitle, frSaid, frHome] = say("lost", "fr");
const [enTitle, enSaid, enHome] = say("lost", "en");
---
<Page lang="fr" title={`${frTitle} · ${enTitle} · Kitokey`} description={frSaid} path="" kind="wrap lost-page">
  <div class="lost" lang="fr"><h1>{frTitle}</h1><p>{frSaid}</p><a class="home" href="/fr/">{frHome}</a></div>
  <div class="lost" lang="en"><p class="lost-h">{enTitle}</p><p>{enSaid}</p><a class="home" href="/en/">{enHome}</a></div>
</Page>
