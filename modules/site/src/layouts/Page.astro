---
// Every page's frame (D114, site v7 validated by the decider on 2026-11-26): its head (title,
// description, hreflang both ways, the titles' face preloaded and, until the decider opens the site,
// noindex), the sticky header (the brand, the sections, the other language, the theme's moon and sun),
// the halo behind the page, and the footer.
import "../styles/site.css";
import "../styles/hero.css";
import { open } from "../../site.config.mjs";
import { say } from "../lib/words.mjs";

const { lang, title, description, path, kind, nav = [] } = Astro.props;
const other = lang === "en" ? "fr" : "en";
const site = Astro.site;
const url = (l) => new URL(`/${l}/${path}`, site).href;
const source = "https://github.com/NapkinStack/kitokey";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!open && <meta name="robots" content="noindex" />}
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#F2F4F7" />
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="en" href={url("en")} />
    <link rel="alternate" hreflang="fr" href={url("fr")} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
    <link rel="icon" href="/kitokey.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script src="/theme.js" is:inline></script>
    <slot name="head" />
  </head>
  <body>
    <div class="halo" aria-hidden="true"><i class="h1"></i><i class="h2"></i><i class="h3"></i></div>
    <a class="skip" href="#main">{say("skip", lang)}</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={`/${lang}/`}><img src="/kitokey.svg" width="26" height="26" alt="" />Kitokey</a>
        {nav.length > 0 && <nav class="nav" aria-label={say("sections", lang)}>{nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>}
        <a class="lang" href={`/${other}/${path}`} hreflang={other} lang={other} aria-label={`${other.toUpperCase()}, ${say("other", lang)}`}>{other.toUpperCase()}</a>
        <button type="button" class="theme-toggle" aria-pressed="false" data-dark={say("theme", lang)[0]} data-light={say("theme", lang)[1]} aria-label={say("theme", lang)[0]} hidden>
          <svg class="ico i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
          <svg class="ico i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </button>
      </div>
    </header>
    <main id="main" class={kind}><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <a class="brand" href={`/${lang}/`}><img src="/kitokey.svg" width="24" height="24" alt="" />Kitokey</a>
        <span class="pub">{say("publisher", lang)}</span>
        <nav aria-label={say("footer", lang)}>
          <a href={source}>{say("source", lang)}</a>
          <a href={`/${lang}/privacy/`}>{say("privacy", lang)}</a>
          <a href={`/${other}/${path}`} hreflang={other} lang={other}>{say("other", lang)}</a>
        </nav>
        <span class="credit">{say("credit", lang)}</span>
      </div>
    </footer>
  </body>
</html>
