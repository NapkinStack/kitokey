---
import Page from "../layouts/Page.astro";
import { say } from "../lib/words.mjs";
const { lang } = Astro.props;
---
<Page lang={lang} title={say("title", lang)} description={say("description", lang)} path="">
  <h1>{say("promise", lang)}</h1>
  <p class="lead">{say("description", lang)}</p>
  <ul class="cards">
    <li>{say("local", lang)}</li>
    <li>{say("windows", lang)} {say("price", lang)}</li>
    <li>{say("linux", lang)}</li>
  </ul>
</Page>
